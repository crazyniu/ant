  "author_notes": {
    "armor_intent": "Alternate forward/reverse cycles of purple,yellow,blue,white,red,green; 3 independently sized segment(s) per present color.",
    "failure_boundary_cases": [
      "Final hit and princess contact at exactly the same microsecond: victory.",
      "Contact one microsecond before final hit: defeat; later hit cannot overturn.",
      "Empty board and last delivery are not victory; final projectile must hit."
    ],
    "motif": "Crystal Citadel",
    "playtest_conclusion": "NOT_RUN: automated proof is not a human difficulty, motif-recognition or visual acceptance.",
    "progression_band": "21–30 combined planning",
    "queue_intent": "First-front color order white,red,blue,purple,yellow,green. Later quota slices rotate between lanes; selecting a front reveals a different future color. A sixth initial color, if present, follows the fifth front in column 5. Team quotas vary independently of armor slices.",
    "teaching_goal": "Three towers, two windows and enclosed gate: multi-object quota planning.",
    "time_budget_policy": "Predeclared budget = ceil(beads × dispatch + teams × 0.75 + armor segments × cooldown × 0.60 + twice width-plus-height / 14 + band grace). Measured final-hit tail and margin must be recorded after authoritative replay."
  },
